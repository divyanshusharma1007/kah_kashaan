MONGODB_URI=
MONGODB_PASSWORD=
MONGODB_DB=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# ImageKit is the primary private artist-photo provider. Find the private key
# in ImageKit Developer Options and the URL endpoint in the ImageKit dashboard.
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Cloudinary is used when ImageKit is not configured or an ImageKit upload fails.
CLOUDINARY_URL=
# Or configure these individually instead of CLOUDINARY_URL:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
AUTH_SECRET=
# Optional: when omitted, the app origin is derived from GOOGLE_REDIRECT_URI.
APP_URL=
# Generate an App Password for the Gmail account used to send verification emails.
SMTP_USER=
SMTP_APP_PASSWORD=
# Address that receives admin activity and incoming request notifications.
ADMIN_NOTIFICATION_EMAIL=

# Razorpay online event payments. Use test keys for development and live keys
# only after enabling the required payment methods in the Razorpay dashboard.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
